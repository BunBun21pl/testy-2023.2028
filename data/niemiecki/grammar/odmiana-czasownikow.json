      ],
      "why": "werden: du wirst."
    },
    {
      "id": "odm-10",
      "q": "Was ___ du? (sehen)",
      "correct": "siehst",
      "wrong": [
        "sehst",
        "siehest",
        "sehen"
      ],
      "why": "sehen: e → ie, du siehst."
    }
  ]
}